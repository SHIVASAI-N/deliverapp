# ==============================================================================
# DELIVERAPP (EPICUREAN CURATIONS) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Service
NODE_ENV=development
PORT=5000
JWT_SECRET=super_secret_epicurean_jwt_key_2026

# Database & Cache
DATABASE_URL=postgresql://deliverapp_user:epicurean_secret_2026@localhost:5432/deliverapp_db?schema=public
REDIS_URL=redis://localhost:6379

# Payments (Test Mode)
RAZORPAY_KEY_ID=rzp_test_epicurean_demo
RAZORPAY_KEY_SECRET=rzp_secret_demo
STRIPE_SECRET_KEY=sk_test_51...

# Realtime, Telemetry & Push Notifications
FIREBASE_SERVER_KEY=AAAA...

# Google Maps Platform Keys (Four Separate Restricted Keys for Least Privilege)
# 1. Server-side key: Used strictly by services/backend (Google Routes API v2, Geocoding, Places)
#    Restriction: IP addresses (Backend server static IPs)
GOOGLE_MAPS_SERVER_KEY=AIzaSy...

# 2. Web Client key: Used by apps/restaurant-dashboard (@vis.gl/react-google-maps)
#    Restriction: Websites / HTTP Referrers (e.g., https://kitchen.deliverapp.com/*, http://localhost:3000/*)
NEXT_PUBLIC_GOOGLE_MAPS_WEB_KEY=AIzaSy...

# 3. Android Native key: Used by apps/customer & apps/delivery-partner (react-native-maps PROVIDER_GOOGLE)
#    Restriction: Android apps (Package Name: com.deliverapp.customer, SHA-1 certificate fingerprint)
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=AIzaSy...

# 4. iOS Native key: Used by apps/customer & apps/delivery-partner (react-native-maps PROVIDER_GOOGLE)
#    Restriction: iOS apps (Bundle Identifier: com.deliverapp.customer, com.deliverapp.delivery)
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=AIzaSy...

# Frontend Apps Endpoints
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
EXPO_PUBLIC_API_URL=http://localhost:5000
